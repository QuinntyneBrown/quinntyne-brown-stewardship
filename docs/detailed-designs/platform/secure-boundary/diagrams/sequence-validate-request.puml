@startuml
title UML sequence behaviour — Validate a request at the boundary
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Untrusted caller" as actor
box "Frontend — Stewardship web client" #E0F2FE
  participant "Angular interpolation" as render
end box
box "Backend — Stewardship API application" #D1FADF
  participant "HttpsRedirectionMiddleware" as https
  participant "JsonSerializerOptions" as binding
  participant "NotesController" as controller
  participant "ProblemDetailsExceptionHandler" as problem
end box
box "Backend — Stewardship Application and Domain" #ECFDF3
  participant "ValidationBehavior" as behavior
  participant "SaveNoteCommandHandler" as handler
end box
box "Backend — Stewardship Infrastructure" #FFF4E5
  database "Stewardship database" as db
end box

actor -> https : POST /notes over plain HTTP
https --> actor : Redirect to HTTPS (L2-037 criterion 1)
actor -> https : POST /notes over HTTPS with an oversized body and undefined fields
https -> binding : Bind the request body
binding -> binding : Skip members the endpoint does not define (L2-036 criterion 4)
binding -> controller : Bound command carrying only defined fields
controller -> behavior : Send SaveNoteCommand through the pipeline
behavior -> behavior : Run every validator before the handler
alt L2-036 criteria 1 and 2 — a field is missing, malformed, or too long
  behavior -> problem : Raise the validation failure
  problem --> actor : 400 naming the invalid field, no state changed, no internal detail
else The command is valid
  behavior -> handler : Continue to the handler
  handler -> db : Store the note body as submitted text
  db --> handler : Commit result
  handler --> controller : NoteResponse
  controller --> render : 200 with the stored text
  render -> render : Escape the text on output (L2-036 criterion 3)
  render --> actor : Present markup as literal text, executing nothing
end
@enduml
