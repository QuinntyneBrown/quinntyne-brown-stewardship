@startuml
title UML sequence behaviour — Correlate a request and audit a booking action
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Participant" as actor
box "Frontend — Stewardship web client" #E0F2FE
  participant "BookingPanelComponent" as panel
end box
box "Backend — Stewardship API application" #D1FADF
  participant "CorrelationIdMiddleware" as correlation
  participant "SessionsController" as controller
end box
box "Backend — Stewardship Application and Domain" #ECFDF3
  participant "LoggingBehavior" as logging
  participant "CancelSessionCommandHandler" as handler
  participant "IAuditWriter" as audit
end box
box "Backend — Stewardship Infrastructure" #FFF4E5
  database "Stewardship database" as db
end box

actor -> panel : Cancel the held session
panel -> correlation : DELETE /sessions/{id}
correlation -> correlation : Assign a correlation identifier to the request
correlation -> controller : Continue with the correlated request
controller -> logging : Send CancelSessionCommand through the pipeline
logging -> handler : Continue to the handler
handler -> db : Cancel the session
db --> handler : Commit result
handler -> audit : Record the cancellation
audit -> db : Write the acting participant, the action, and the time (L2-040 criterion 4)
db --> audit : Commit result
audit --> handler : Recorded
handler --> logging : Cancelled
logging -> logging : Log the request with its correlation identifier and duration
logging --> controller : Cancelled
alt An unhandled error occurred
  controller --> panel : 500 carrying the correlation identifier (L2-040 criterion 3)
  panel --> actor : State the failure and show the identifier to quote
else The cancellation succeeded
  controller --> panel : 200
  panel --> actor : Present the released slot
end
@enduml
