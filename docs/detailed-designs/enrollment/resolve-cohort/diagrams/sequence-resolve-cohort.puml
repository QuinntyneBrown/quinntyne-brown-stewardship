@startuml
title UML sequence behaviour — Resolve the cohort
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Participant" as actor
box "Frontend — Stewardship web client" #E0F2FE
  participant "AppShellComponent" as shell
  participant "NotEnrolledNoticeComponent" as notice
  participant "CohortService" as client
end box
box "Backend — Stewardship API application" #D1FADF
  participant "EnrollmentController" as controller
end box
box "Backend — Stewardship Application and Domain" #ECFDF3
  participant "GetEnrollmentQueryHandler" as handler
  participant "Cohort" as cohort
end box
box "Backend — Stewardship Infrastructure" #FFF4E5
  database "Stewardship database" as db
end box

actor -> shell : Open the programme
shell -> client : Request the enrollment context
client -> controller : GET /enrollment
controller -> handler : Send GetEnrollmentQuery
handler -> db : Read the active enrollment for the acting participant
db --> handler : Enrollment with its cohort, or no row
alt L2-007 — no active enrollment
  handler --> controller : Not enrolled
  controller --> client : 200 stating no cohort is assigned
  client --> shell : Not-enrolled context
  shell -> notice : Render the explicit notice
  notice --> actor : State that no cohort has been assigned, with no path, figures, or booking panel
else An active enrollment resolves
  handler -> cohort : Derive the current week from the start date (L2-006 criterion 1)
  cohort --> handler : Week number, capped at the 12-week duration
  handler -> cohort : Derive the session allowance from duration and cadence (L2-006 criterion 2)
  cohort --> handler : Allowance of 6
  handler -> cohort : Determine whether the cohort has ended
  cohort --> handler : Ended or running
  handler --> controller : Enrollment context
  controller --> client : 200 with cohort name, week, end date, allowance, and mentor
  client --> shell : Enrollment context held in a signal
  shell --> actor : Present the programme scoped to this cohort (L2-005)
end
@enduml
